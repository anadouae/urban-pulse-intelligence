# Java API
SERVER_PORT=3847
URBAN_PULSE_KAFKA_ENABLED=true
KAFKA_BOOTSTRAP=127.0.0.1:9092

# Security — leave empty for open local demo; set for hardened demo
URBAN_PULSE_API_KEY=
URBAN_PULSE_API_KEY_REQUIRED=false
URBAN_PULSE_H2_CONSOLE=true

# Optional Postgres profile: SPRING_PROFILES_ACTIVE=postgres
# SPRING_DATASOURCE_URL=jdbc:postgresql://127.0.0.1:5432/urbanpulse
# SPRING_DATASOURCE_USERNAME=urbanpulse
# SPRING_DATASOURCE_PASSWORD=urbanpulse

# Web (optional absolute API; leave empty to use Vite proxy)
VITE_API_BASE=

# Ingestion
URBAN_PULSE_API=http://127.0.0.1:3847

# ML service
ML_API_KEY=
